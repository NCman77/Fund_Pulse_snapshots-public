{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Public raw market snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "market", "region", "capturedAt", "session", "source", "isDelayed", "quoteStatus", "scheduleRule", "scheduledAt", "captureDelaySeconds", "timingStatus", "quotes"],
  "properties": {
    "schemaVersion": { "const": "1.2" },
    "market": { "type": "string", "pattern": "^[a-z]{2,8}$" },
    "region": { "type": "string", "enum": ["asia", "europe", "america"] },
    "capturedAt": { "type": "string", "format": "date-time" },
    "session": { "type": "string", "enum": ["preopen", "regular", "close"] },
    "source": { "type": "string", "minLength": 1 },
    "isDelayed": { "type": "boolean" },
    "quoteStatus": { "type": "string", "enum": ["current_market_date"] },
    "scheduleRule": { "type": ["string", "null"] },
    "scheduledAt": { "type": ["string", "null"], "format": "date-time" },
    "captureDelaySeconds": { "type": ["number", "null"] },
    "timingStatus": { "type": "string", "enum": ["on_time", "late", "manual_or_unknown"] },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "endpointType"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "endpointType": { "type": "string", "minLength": 1 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "endpointType", "expectedSymbolCount", "capturedSymbolCount", "failedSymbols", "complete"],
      "properties": {
        "provider": { "type": "string", "minLength": 1 },
        "endpointType": { "type": "string", "minLength": 1 },
        "expectedSymbolCount": { "type": "integer", "minimum": 0 },
        "capturedSymbolCount": { "type": "integer", "minimum": 0 },
        "failedSymbols": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "complete": { "type": "boolean" }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$" },
        "role": { "type": "string", "enum": ["primary", "backup"] }
      }
    },
    "quotes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "currency"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "open": { "type": "number" },
          "high": { "type": "number" },
          "low": { "type": "number" },
          "close": { "type": "number" },
          "previousClose": { "type": "number" },
          "quoteAt": { "type": "string", "format": "date-time" },
          "currency": { "type": "string", "pattern": "^[A-Z]{3}$" }
        }
      }
    }
  }
}
